# Copy to .env (cp .env.example .env) and change every value marked CHANGE-ME.
# .env is git-ignored. Everything binds to 127.0.0.1 by default.

# --- Postgres "lakebase" (CDC source) ---
LAKEBASE_USER=lakebase
LAKEBASE_PASSWORD=CHANGE-ME-lakebase
LAKEBASE_DB=lakebase
LAKEBASE_PORT=15432
# Dedicated replication role used by Debezium / OLake / Airbyte
CDC_USER=cdc_reader
CDC_PASSWORD=CHANGE-ME-cdc

# --- Message DB (Postgres + message_store schema) ---
MESSAGEDB_USER=postgres
MESSAGEDB_PASSWORD=CHANGE-ME-messagedb
MESSAGEDB_PORT=15433

# --- Gateway ---
# Which event store backs POST /streams/{stream}: kurrentdb | messagedb
STORE=kurrentdb
GATEWAY_PORT=8088
# Browser origins allowed by CORS (comma separated). Add the origin you serve the site from.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080
# Optional: forward POST /TOPIC/... to Solace REST (profile "solace"). Leave empty to disable.
SOLACE_REST_URL=

# --- Ports ---
KAFKA_EXTERNAL_PORT=29092
KAFKA_REST_PORT=8082
CONNECT_PORT=8083
KURRENTDB_PORT=2113

# --- Solace (profile "solace") ---
SOLACE_ADMIN_PASSWORD=CHANGE-ME-solace
SOLACE_REST_PORT=9000
SOLACE_MGMT_PORT=18080

# --- OLake (profile "olake") ---
OLAKE_SLOT=olake_slot
