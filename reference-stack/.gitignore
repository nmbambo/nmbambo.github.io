# Local secrets and runtime state. Never commit these.
.env
*.env.local
__pycache__/
*.pyc
.venv/
venv/
# Harness output is measured data from YOUR machine; commit deliberately, not by accident.
results/*.json
results/*.md
!results/.gitkeep
