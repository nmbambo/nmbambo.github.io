cdc/olake/config/source.json
cdc/olake/config/streams.json
cdc/olake/config/state.json
cdc/olake/config/source-*.json
cdc/olake/config/destination-*.json
cdc/olake/config/state-*.json
cdc/olake/config/destination.json
cdc/olake/out/
# Airbyte connection ids / tokens kept locally
cdc/airbyte/airbyte.local.env
tests/live/out/
